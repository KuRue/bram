<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Agent work is expected to outlive the user looking at the screen, so a run holds a
         foreground service; without it Android may kill the process and abandon the task. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Milestone 11 tool surface: the runtime permissions the platform tools ask for. Each is
         requested through the system dialog when a tool call is approved and the permission is
         missing; none is required to install or run. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Exact alarms are a special app-op on API 31+. Declared so the reminder tool can schedule
         exactly when the user has granted it; otherwise it falls back to inexact timing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Termux declares this permission for third-party apps that run commands in its context.
         The user grants it on the App Info > Permissions > Additional permissions screen. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Package visibility: targeting API 30+ hides other packages unless declared, and Termux's
         RUN_COMMAND service cannot be reached without this. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".BramApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bram"
        android:usesCleartextTraffic="true">
        <!--
            Reaching the Hexagon NPU means dlopen'ing Qualcomm's CDSP RPC libraries. They are listed
            in /vendor/etc/public.libraries.txt, but since Android 12 an app must also name them
            here or the load fails with "library not found". Optional, so the app still installs and
            runs on devices without a Hexagon DSP.
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <service
            android:name=".AgentTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives the result bundle Termux sends for a termux_exec call. Exported to nobody:
             the PendingIntent Bram hands to Termux is what delivers the result. -->
        <service
            android:name=".TermuxResultService"
            android:exported="false" />

        <!-- Turns a scheduled reminder alarm into the notification it was asked for. -->
        <receiver
            android:name=".ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- Wakes the app process when a scheduled task comes due, so the queue can start it. -->
        <receiver
            android:name=".TaskAlarmReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
