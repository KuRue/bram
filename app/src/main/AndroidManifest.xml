<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Agent work is expected to outlive the user looking at the screen, so a run holds a
         foreground service; without it Android may kill the process and abandon the task. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BramApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bram"
        android:usesCleartextTraffic="true">
        <!--
            Reaching the Hexagon NPU means dlopen'ing Qualcomm's CDSP RPC libraries. They are listed
            in /vendor/etc/public.libraries.txt, but since Android 12 an app must also name them
            here or the load fails with "library not found". Optional, so the app still installs and
            runs on devices without a Hexagon DSP.
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />

        <service
            android:name=".AgentTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The "Reply" action on the completion alert. Same process as the app, so a reply can
             reach the running conversation without bringing the app forward. -->
        <receiver
            android:name=".CompletionReplyReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
