<?xml version="1.0" encoding="utf-8"?>
<!--
    minSdk is 29, so every device that can install Bram supports adaptive icons and there is no
    legacy bitmap to keep in step. The layers are vectors for the same reason: one definition that
    is sharp on every density, rather than five PNGs that drift apart.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
